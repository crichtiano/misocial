mixin card(oneCard)
    figure.card 
        figcaption 
            img(src=oneCard.img, alt=oneCard.alt)
            p.personal  #{oneCard.personal}
            p.price 
                span.corrency  #{oneCard.corrency}
                b  #{oneCard.price}
                if oneCard.isMonth 
                    | /isMonth
                else 
                    | /year
            ul.description 
                for itemText in oneCard.description 
                    li #{itemText}
            a(href=oneCard.btnHref) #{oneCard.btnText}        

            
