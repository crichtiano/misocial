-
    let mainMenu = [
        ['Home', 'index.html'],
        ['Why MISOCIAL', '#'],
        ['Features', '#'],
        ['Articles', '#'],
        ['Pricing', '#'],
    ]

mixin menu(mainMenu, colorTheme='light')
    .navigation 
        .logo 
            a(href="index.htnl")
                img(src="assets/images/logo.png", alt="")
        nav.flex.nav 
            ul(class=colorTheme).menu
                for item in mainMenu 
                    li 
                        a(href=item[1]) #{item[0]}
            p(class=colorTheme).cta_empty
                a(href="#").btm get started

